{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "commonjs",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "incremental": true,
    "baseUrl": ".",
    "paths": {
      "@ai-calling-agent/types": ["packages/types/src"],
      "@ai-calling-agent/shared": ["packages/shared/src"],
      "@ai-calling-agent/utils": ["packages/utils/src"],
      "@ai-calling-agent/config": ["packages/config/src"],
      "@ai-calling-agent/ui": ["packages/ui/src"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next"]
}
