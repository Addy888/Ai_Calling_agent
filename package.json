{
  "name": "ai-calling-agent",
  "version": "1.0.0",
  "description": "Enterprise AI Calling Agent Platform - Phase 1 Foundation",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:web\" \"npm run dev:api\"",
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build": "npm run build --workspaces",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "db:generate": "cd database/prisma && npx prisma generate",
    "db:migrate": "cd database/prisma && npx prisma migrate dev",
    "db:seed": "cd database/prisma && npx prisma db seed",
    "db:studio": "cd database/prisma && npx prisma studio",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\""
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "concurrently": "^8.2.2",
    "prettier": "^3.2.4",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
