# Database
DATABASE_URL="mysql://root:Aditya%40@localhost:3306/ai_calling_agent"

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# API
API_PORT=3001
API_HOST=localhost
API_PREFIX=api/v1

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-use-at-least-32-characters
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-this-in-production-use-64-chars
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_ROUNDS=10
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Environment
NODE_ENV=development

# File Upload
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=.csv,.xlsx,.pdf,.docx

# Storage
STORAGE_PATH=./storage

# Logging
LOG_LEVEL=debug

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# =========================================================
# Speech-to-Text (STT) Configuration
# =========================================================

# Primary STT Provider (faster-whisper, openai-whisper, deepgram, azure-speech, google-speech)
STT_PROVIDER=faster-whisper

# Faster Whisper Service
FASTER_WHISPER_ENDPOINT=http://localhost:9000
WHISPER_MODEL_SIZE=base

# OpenAI Whisper API
OPENAI_API_KEY=your-openai-api-key-here

# Deepgram
DEEPGRAM_API_KEY=your-deepgram-api-key-here

# Azure Speech
AZURE_SPEECH_KEY=your-azure-speech-key-here
AZURE_SPEECH_REGION=eastus

# Google Cloud Speech
GOOGLE_APPLICATION_CREDENTIALS=./path/to/google-credentials.json

# Voice Activity Detection (VAD)
STT_VAD_SPEECH_THRESHOLD=0.025
STT_VAD_SILENCE_THRESHOLD=0.015
STT_VAD_SILENCE_MS=1200
STT_VAD_SHORT_PAUSE_MS=500

# Audio Processing
STT_SAMPLE_RATE=16000
STT_NOISE_REDUCTION_ENABLED=true
STT_NOISE_THRESHOLD=0.015

# STT Performance
STT_MAX_BUFFER_SECONDS=10
STT_PARTIAL_RESULTS_ENABLED=true
STT_STREAMING_CHUNK_MS=20

# Language Support
STT_DEFAULT_LANGUAGE=auto
STT_SUPPORTED_LANGUAGES=en,hi,hi-en,mr

# =========================================================
# Text-to-Speech (TTS) Configuration
# =========================================================

# Primary TTS Provider (elevenlabs, azure-tts, google-tts, openai-tts)
TTS_PROVIDER=elevenlabs

# ElevenLabs TTS
ELEVENLABS_API_KEY=your-elevenlabs-api-key-here
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL

# Azure TTS
AZURE_TTS_KEY=your-azure-tts-key-here
AZURE_TTS_REGION=eastus

# Google TTS
GOOGLE_TTS_CREDENTIALS=./path/to/google-tts-credentials.json

# OpenAI TTS
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy

# =========================================================
# TELEPHONY ENGINE - PRODUCTION GSM GATEWAY CONFIGURATION
# =========================================================

# Active Telephony Provider (asterisk for GSM Gateway)
TELEPHONY_ENGINE_PROVIDER=asterisk

# =========================================================
# ASTERISK - PRODUCTION CONFIGURATION
# =========================================================

# Production Asterisk Server
ASTERISK_ENABLED=true
ASTERISK_HOST=192.168.1.4
ASTERISK_VERSION=1.8.23.0

# AMI (Asterisk Manager Interface)
ASTERISK_AMI_PORT=5038
ASTERISK_AMI_USERNAME=admin
ASTERISK_AMI_SECRET=change-me-with-real-ami-password
ASTERISK_AMI_EVENTS=true

# AGI (Asterisk Gateway Interface)
ASTERISK_AGI_PORT=4573
ASTERISK_AGI_ENABLED=true

# Dialplan Configuration
ASTERISK_CONTEXT=ai-calling
ASTERISK_EXTENSION=s
ASTERISK_PRIORITY=1

# Call Recording
ASTERISK_RECORDING_ENABLED=true
ASTERISK_RECORDING_PATH=/var/spool/asterisk/monitor
ASTERISK_RECORDING_FORMAT=wav

# Connection Settings
ASTERISK_CONNECTION_TIMEOUT=30000
ASTERISK_MAX_RECONNECT_ATTEMPTS=10
ASTERISK_RECONNECT_INTERVAL=5000
ASTERISK_HEALTH_CHECK_INTERVAL_MS=30000
ASTERISK_KEEPALIVE=true
ASTERISK_KEEPALIVE_DELAY=60000

# Channel Settings
ASTERISK_MAX_CHANNELS=100
ASTERISK_DEFAULT_TIMEOUT=30

# =========================================================
# GSM GATEWAY - DINSTAR PRODUCTION
# =========================================================

# Dinstar GSM Gateway Configuration
GSM_GATEWAY_ENABLED=true
GSM_GATEWAY_VENDOR=Dinstar
GSM_GATEWAY_MODEL=UC2000-VG-16G
GSM_GATEWAY_HOST=192.168.1.8
GSM_GATEWAY_IP=192.168.1.8
GSM_GATEWAY_PORT=5060
GSM_GATEWAY_NAME=Dinstar-Gateway-1

# SIP Configuration
GSM_GATEWAY_PROTOCOL=SIP
GSM_GATEWAY_USERNAME=admin
GSM_GATEWAY_PASSWORD=change-me-with-real-gateway-password
GSM_TOTAL_SIMS=16
GSM_TOTAL_PORTS=16

# SIP Peer Configuration
SIP_PEER_NAME=GSM1
SIP_PEER_TYPE=peer
SIP_PEER_CONTEXT=ai-calling
SIP_PEER_HOST=192.168.1.8
SIP_PEER_PORT=5060

# Codec Configuration (Order of preference)
SIP_CODECS=gsm,ulaw,alaw,g729
SIP_CODEC_GSM=yes
SIP_CODEC_ULAW=yes
SIP_CODEC_ALAW=yes
SIP_CODEC_G729=yes

# Gateway Health Monitoring
GSM_GATEWAY_HEALTH_CHECK_INTERVAL=60000
GSM_GATEWAY_PING_TIMEOUT=5000
GSM_GATEWAY_MAX_FAILURES=3

# =========================================================
# SIM CARD MANAGEMENT
# =========================================================

# SIM Allocation Strategy
SIM_ALLOCATION_STRATEGY=round-robin
SIM_HEALTH_CHECK_ENABLED=true
SIM_SIGNAL_STRENGTH_THRESHOLD=15
SIM_MIN_SIGNAL_REQUIRED=10

# SIM Auto-Registration
SIM_AUTO_REGISTER=true
SIM_REGISTRATION_TIMEOUT=30000

# SIM Load Balancing
SIM_LOAD_BALANCING_ENABLED=true
SIM_MAX_CONCURRENT_CALLS_PER_SIM=1

# SIM Cooldown Settings
SIM_COOLDOWN_ENABLED=true
SIM_COOLDOWN_DURATION_MS=5000

# =========================================================
# CALL ORCHESTRATION SETTINGS
# =========================================================

# Call Timeout & Retry
CALL_TIMEOUT_SECONDS=60
CALL_RING_TIMEOUT_SECONDS=30
CALL_MAX_RETRY_ATTEMPTS=3
CALL_RETRY_DELAY_SECONDS=300

# Recording Settings
TELEPHONY_ENGINE_RECORDING_ENABLED=true
CALL_RECORDING_FORMAT=wav
CALL_RECORDING_MIX_MODE=both

# Call Quality Monitoring
CALL_QUALITY_MONITORING_ENABLED=true
CALL_QUALITY_SAMPLE_RATE=16000
CALL_QUALITY_BIT_DEPTH=16

# Maximum Concurrent Calls
TELEPHONY_ENGINE_MAX_CONCURRENT_CALLS=50
MAX_CONCURRENT_CALLS_PER_GATEWAY=10

# =========================================================
# CLOUD TELEPHONY PROVIDERS (Optional Backup)
# =========================================================

# Twilio Configuration (Backup Provider)
TWILIO_ENABLED=false
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_SECRET=your-twilio-webhook-secret

# Exotel Configuration (Backup Provider)
EXOTEL_ENABLED=false
EXOTEL_API_KEY=your-exotel-api-key
EXOTEL_API_TOKEN=your-exotel-api-token
EXOTEL_SID=your-exotel-sid
EXOTEL_PHONE_NUMBER=+919876543210
EXOTEL_API_ENDPOINT=https://api.exotel.com/v1

# Plivo Configuration (Backup Provider)
PLIVO_ENABLED=false
PLIVO_AUTH_ID=your-plivo-auth-id
PLIVO_AUTH_TOKEN=your-plivo-auth-token
PLIVO_PHONE_NUMBER=+1234567890
PLIVO_API_ENDPOINT=https://api.plivo.com/v1

# =========================================================
# DIAGNOSTICS & MONITORING
# =========================================================

# Health Check Endpoints
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_MS=30000

# System Diagnostics
DIAGNOSTICS_ENABLED=true
DIAGNOSTICS_LOG_LEVEL=info
DIAGNOSTICS_ALERT_ON_FAILURE=true

# Performance Monitoring
PERFORMANCE_MONITORING_ENABLED=true
PERFORMANCE_LOG_SLOW_CALLS=true
PERFORMANCE_SLOW_CALL_THRESHOLD_MS=3000

# =========================================================
# WEBHOOK & CALLBACKS
# =========================================================

# Webhook Settings
TELEPHONY_ENGINE_WEBHOOK_BASE_URL=${API_BASE_URL}
TELEPHONY_ENGINE_WEBHOOK_VERIFY_SIGNATURE=false
WEBHOOK_RETRY_ATTEMPTS=3
WEBHOOK_RETRY_DELAY_MS=1000

# =========================================================
# Telephony Configuration - Twilio Provider
# =========================================================

# Twilio Configuration (Production)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WEBHOOK_SECRET=your-twilio-webhook-secret

# API Base URL (for webhook callbacks from Twilio)
API_BASE_URL=https://your-domain.com

# Ngrok URL for local development
# API_BASE_URL=https://abc123.ngrok.io

# =========================================================
# LLM Configuration (for AI Conversation)
# =========================================================

# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=500

# Alternative LLM Providers
ANTHROPIC_API_KEY=your-anthropic-key-here
AZURE_OPENAI_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# =========================================================
# Conversation Runtime Engine Configuration (New)
# =========================================================

# Runtime Engine
CONVERSATION_RUNTIME_ENABLED=true

# AI Intent Detection
USE_AI_INTENT_DETECTION=true
INTENT_CONFIDENCE_THRESHOLD=0.7

# Silence Detection
CONVERSATION_SILENCE_TIMEOUT=30
CONVERSATION_MAX_SILENCE_COUNT=3

# Response Configuration
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=150
RESPONSE_MAX_LENGTH=300

# Conversation Limits
MAX_CONVERSATION_HISTORY=20
MAX_CONVERSATION_DURATION=1800

# Validation
RESPONSE_VALIDATION_ENABLED=true
MIN_RESPONSE_CONFIDENCE=0.6

# Fallback Configuration
FALLBACK_ENABLED=true
FALLBACK_MAX_RETRIES=2

# =========================================================
# Campaign Configuration
# =========================================================

# Concurrent calls per campaign
MAX_CONCURRENT_CALLS=5

# Call timeout (seconds)
CALL_TIMEOUT=120

# Retry configuration
MAX_RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=300

# =========================================================
# Webhook Configuration
# =========================================================

# API Base URL (for webhook callbacks from Twilio/Exotel)
API_BASE_URL=https://your-domain.com

# Ngrok URL for local development
# API_BASE_URL=https://abc123.ngrok.io
