// ============================================
// MODEL COMPATIBILITY ENGINE - PHASE 4.4.2.4
// ============================================

model CompatibilityReport {
  id                      String                    @id @default(uuid())
  companyId               String                    @db.VarChar(191)
  datasetId               String                    @db.VarChar(191)
  modelRegistryId         String                    @db.VarChar(191)
  trainingConfigId        String?                   @db.VarChar(191)
  
  // Compatibility Scores
  languageScore           Float                     @default(0.0)
  contextScore            Float                     @default(0.0)
  datasetScore            Float                     @default(0.0)
  hardwareScore           Float                     @default(0.0)
  licenseScore            Float                     @default(0.0)
  overallScore            Float                     @default(0.0)
  
  // Analysis Results
  languageCompatibility   CompatibilityStatus       @default(UNKNOWN)
  contextCompatibility    CompatibilityStatus       @default(UNKNOWN)
  datasetCompatibility    CompatibilityStatus       @default(UNKNOWN)
  hardwareCompatibility   CompatibilityStatus       @default(UNKNOWN)
  licenseCompatibility    CompatibilityStatus       @default(UNKNOWN)
  
  // Recommendations
  recommendation          CompatibilityRecommendation @default(NEEDS_REVIEW)
  recommendationReason    String?                   @db.Text
  
  // Details
  languageDetails         Json?
  contextDetails          Json?
  datasetDetails          Json?
  hardwareDetails         Json?
  licenseDetails          Json?
  quantizationDetails     Json?
  
  // Warnings
  warnings                Json?
  blockers                Json?
  suggestions             Json?
  
  // Status
  status                  ReportStatus              @default(PENDING)
  checkStartedAt          DateTime?
  checkCompletedAt        DateTime?
  executionTime           Int?
  
  // Metadata
  metadata                Json?
  checkedBy               String?                   @db.VarChar(255)
  createdAt               DateTime                  @default(now())
  updatedAt               DateTime                  @updatedAt

  @@index([companyId])
  @@index([datasetId])
  @@index([modelRegistryId])
  @@index([trainingConfigId])
  @@index([overallScore])
  @@index([recommendation])
  @@index([status])
  @@index([createdAt])
  @@map("compatibility_reports")
}

enum CompatibilityStatus {
  COMPATIBLE
  PARTIALLY_COMPATIBLE
  WARNING
  NOT_COMPATIBLE
  UNKNOWN
}

enum CompatibilityRecommendation {
  RECOMMENDED
  ACCEPTABLE
  NEEDS_IMPROVEMENT
  NOT_RECOMMENDED
  NEEDS_REVIEW
}

enum ReportStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

