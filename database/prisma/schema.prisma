  @@index([conversationId])
  @@index([companyId])
  @@index([sessionId])
  @@index([callId])
  @@index([contactId])
  @@index([campaignId])
  @@index([detectedIntent])
  @@index([conversationAction])
  @@index([leadQualification])
  @@index([overallConfidence])
  @@index([createdAt])
  @@map("decision_logs")
}

enum IntentType {
