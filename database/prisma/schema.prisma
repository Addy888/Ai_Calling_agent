  SEARCH_KNOWLEDGE
  REPEAT_QUESTION
  CLARIFY
  CONTINUE_SCRIPT
  END_CONVERSATION
  SCHEDULE_FOLLOW_UP
  TRANSFER_TO_HUMAN
}

enum LeadQualificationLevel {
  HOT_LEAD
  WARM_LEAD
  COLD_LEAD
  INTERESTED
  NOT_INTERESTED
