  intentConfidence      Float
  extractedEntities     Json?
  businessRules         Json?
  conversationAction    ConversationActionType
  responsePlan          Json
  leadQualification     LeadQualificationLevel
  confidenceScores      Json
  overallConfidence     Float
  fallbackTriggered     Boolean  @default(false)
  fallbackReason        String?  @db.Text
  decisionReason        String   @db.LongText
  knowledgeContext      Json?
  requiredVariables     Json?
  nextAction            String   @db.VarChar(255)
  executionTime         Int?
  metadata              Json?
  createdAt             DateTime @default(now())

