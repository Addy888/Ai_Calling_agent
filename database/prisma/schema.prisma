  NOT_INTERESTED
  CALL_BACK_LATER
  BUSY
  WRONG_NUMBER
  NEED_PRICING
  NEED_LOCATION
  NEED_DETAILS
  NEED_HUMAN
  GREETING
  GOODBYE
  OTHER
