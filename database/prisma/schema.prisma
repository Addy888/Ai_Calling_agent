  updatedAt             DateTime @updatedAt

  @@index([companyId])
  @@map("runtime_configurations")
}

model AgentHealth {
  id                String      @id @default(uuid())
  agentId           String
  companyId         String
  status            HealthStatus @default(HEALTHY)
  heartbeatAt       DateTime    @default(now())
  memoryUsageMB     Float?
  cpuUsagePercent   Float?
  runtimeLatencyMs  Float?
  responseLatencyMs Float?
  knowledgeLatencyMs Float?
  promptLatencyMs   Float?
  activeSessions    Int         @default(0)
  totalSessions     Int         @default(0)
  successRate       Float?
  errorRate         Float?
  lastError         String?     @db.Text
  recoveryCount     Int         @default(0)
  metadata          Json?
  checkedAt         DateTime    @default(now())

  agent             AIAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([companyId])
  @@index([status])
  @@index([heartbeatAt])
  @@index([checkedAt])
  @@map("agent_health")
}

enum HealthStatus {
  HEALTHY
  DEGRADED
  UNHEALTHY
  CRITICAL
}

model AgentEvent {
  id          String      @id @default(uuid())
  agentId     String
  sessionId   String?
  companyId   String
  eventType   EventType
  eventName   String      @db.VarChar(255)
  eventData   Json?
  severity    EventSeverity @default(INFO)
  message     String?     @db.Text
  metadata    Json?
  timestamp   DateTime    @default(now())

  agent       AIAgent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
  @@index([sessionId])
  @@index([companyId])
  @@index([eventType])
  @@index([severity])
  @@index([timestamp])
  @@map("agent_events")
}

enum EventType {
  AGENT_STARTED
  AGENT_STOPPED
  AGENT_PAUSED
  AGENT_RESUMED
  AGENT_ERROR
  AGENT_RECOVERED
  SESSION_CREATED
  SESSION_CLOSED
  SESSION_PAUSED
  SESSION_RESUMED
  SESSION_EXPIRED
  RUNTIME_READY
  RUNTIME_ERROR
  STATE_CHANGED
  HEALTH_UPDATE
  PERFORMANCE_ALERT
  CONFIGURATION_CHANGED
}

enum EventSeverity {
  DEBUG
  INFO
  WARNING
  ERROR
  CRITICAL
}

model SessionEvent {
  id          String      @id @default(uuid())
  sessionId   String
  eventType   String      @db.VarChar(100)
  eventData   Json?
  timestamp   DateTime    @default(now())

  session     AgentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([eventType])
  @@index([timestamp])
  @@map("session_events")
}

model AgentMetrics {
  id                    String   @id @default(uuid())
  agentId               String
  companyId             String
  date                  DateTime @db.Date
  totalSessions         Int      @default(0)
  activeSessions        Int      @default(0)
  completedSessions     Int      @default(0)
  failedSessions        Int      @default(0)
  averageSessionDuration Float?
  averageResponseTime   Float?
  averageTurnCount      Float?
  successRate           Float?
  errorRate             Float?
  uptime                Float?
  memoryUsageAvg        Float?
  cpuUsageAvg           Float?
  knowledgeQueryCount   Int      @default(0)
  promptExecutionCount  Int      @default(0)
  decisionCount         Int      @default(0)
  metadata              Json?
  createdAt             DateTime @default(now())

  agent                 AIAgent  @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, date])
  @@index([agentId])
  @@index([companyId])
  @@index([date])
  @@index([createdAt])
  @@map("agent_metrics")
}

model RuntimeLog {
  id          String      @id @default(uuid())
  agentId     String?
  sessionId   String?
  companyId   String
  logLevel    LogLevel    @default(INFO)
  logType     String      @db.VarChar(100)
  message     String      @db.Text
  data        Json?
  stackTrace  String?     @db.LongText
  timestamp   DateTime    @default(now())

  @@index([agentId])
  @@index([sessionId])
  @@index([companyId])
  @@index([logLevel])
  @@index([logType])
  @@index([timestamp])
  @@map("runtime_logs")
}

enum LogLevel {
  DEBUG
  INFO
  WARN
  ERROR
  FATAL
}
