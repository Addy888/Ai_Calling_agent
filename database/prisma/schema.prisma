// ============================================
// SCRIPT EXECUTION ENGINE - Phase 3.2
// ============================================

model ScriptVersion {
  id          String       @id @default(uuid())
  scriptId    String
  version     String       @db.VarChar(20)
  status      ScriptStatus @default(DRAFT)
  description String?      @db.Text
  metadata    Json?
  publishedAt DateTime?
  publishedBy String?      @db.VarChar(255)
  createdBy   String?      @db.VarChar(255)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  script      Script            @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  nodes       ScriptNode[]
  branches    ScriptBranch[]
  variables   ScriptVariable[]
  executions  ScriptExecution[]

  @@unique([scriptId, version])
  @@index([scriptId])
  @@index([status])
  @@index([publishedAt])
  @@map("script_versions")
}

enum ScriptStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model ScriptNode {
  id            String   @id @default(uuid())
  versionId     String
  nodeId        String   @db.VarChar(100)
  type          String   @db.VarChar(50)
  name          String   @db.VarChar(255)
  content       String?  @db.LongText
  position      Json?
  config        Json?
  order         Int      @default(0)
  isEntryPoint  Boolean  @default(false)
  isExitPoint   Boolean  @default(false)
  metadata      Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  version       ScriptVersion  @relation(fields: [versionId], references: [id], onDelete: Cascade)
  branchesFrom  ScriptBranch[] @relation("FromNode")
  branchesTo    ScriptBranch[] @relation("ToNode")

  @@unique([versionId, nodeId])
  @@index([versionId])
  @@index([nodeId])
  @@index([type])
  @@index([order])
  @@map("script_nodes")
}

model ScriptBranch {
  id          String   @id @default(uuid())
  versionId   String
  fromNodeId  String
  toNodeId    String
  condition   Json?
  label       String?  @db.VarChar(255)
  order       Int      @default(0)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  version     ScriptVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)
  fromNode    ScriptNode    @relation("FromNode", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNode      ScriptNode    @relation("ToNode", fields: [toNodeId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([fromNodeId])
  @@index([toNodeId])
  @@map("script_branches")
}

model ScriptVariable {
  id          String   @id @default(uuid())
  versionId   String
  name        String   @db.VarChar(100)
  type        String   @db.VarChar(50)
  defaultValue String? @db.Text
  description String?  @db.Text
  isRequired  Boolean  @default(false)
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  version     ScriptVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@unique([versionId, name])
  @@index([versionId])
  @@index([name])
  @@map("script_variables")
}

model ScriptExecution {
  id            String   @id @default(uuid())
  versionId     String
  callId        String?
  contactId     String?
  currentNodeId String?  @db.VarChar(100)
  state         Json?
  variables     Json?
  history       Json?
  status        String   @db.VarChar(50)
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  metadata      Json?

  version       ScriptVersion @relation(fields: [versionId], references: [id], onDelete: Cascade)

  @@index([versionId])
  @@index([callId])
  @@index([contactId])
  @@index([status])
  @@index([startedAt])
  @@map("script_executions")
}

