// Prisma Schema for AI Calling Agent Platform
// Phase 1.4 + 1.5 - Enterprise Foundation with Authentication

generator client {
  provider = "prisma-client-js"
  output   = "../../node_modules/.prisma/client"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
  relationMode = "prisma"
}

// ============================================
// COMPANY & USER MANAGEMENT
// ============================================

model Company {
  id        String   @id @default(uuid())
  name      String   @db.VarChar(255)
  email     String   @unique @db.VarChar(255)
  phone     String?  @db.VarChar(50)
  address   String?  @db.Text
  website   String?  @db.VarChar(255)
  logo      String?  @db.VarChar(500)
  status    String   @default("ACTIVE") @db.VarChar(50)
  isActive  Boolean  @default(true)
  createdBy String?  @db.VarChar(255)
  updatedBy String?  @db.VarChar(255)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?

  users          User[]
  campaigns      Campaign[]
  contacts       Contact[]
  scripts        Script[]
  prompts        Prompt[]
  knowledgeBase  KnowledgeBase[]
  voiceProfiles  VoiceProfile[]
  settings       Setting[]
  activityLogs   ActivityLog[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  analytics      Analytics[]
  reports        Report[]
  fileStorage    FileStorage[]
  aiProviderConfigs AIProviderConfig[]
  aiPersonalities   AIPersonality[]
  promptTemplates   PromptTemplate[]
  voiceLibrary      VoiceLibrary[]
  voiceConfiguration VoiceConfiguration?
  voiceHistory      VoiceHistory[]
  datasets          DatasetRecord[] @relation("CompanyDatasets")
  modelRegistry     ModelRegistry[] @relation("ModelRegistryToCompany")
  fineTuningConfigs FineTuningConfiguration[]
  hyperparameterConfigs HyperparameterConfiguration[]
  trainingStrategies TrainingStrategy[]
  checkpointConfigurations CheckpointConfiguration[]

  @@index([email])
  @@index([isActive])
  @@index([status])
  @@index([createdAt])
  @@map("companies")
}

model User {
  id            String    @id @default(uuid())
  companyId     String
  email         String    @unique @db.VarChar(255)
  password      String    @db.VarChar(255)
  firstName     String    @db.VarChar(100)
  lastName      String    @db.VarChar(100)
  phone         String?   @db.VarChar(50)
  avatar        String?   @db.VarChar(500)
  status        String    @default("ACTIVE") @db.VarChar(50)
  isActive      Boolean   @default(true)
  emailVerified Boolean   @default(false)
  lastLoginAt   DateTime?
  createdBy     String?   @db.VarChar(255)
  updatedBy     String?   @db.VarChar(255)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  company         Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  roles           UserRole[]
  refreshTokens   RefreshToken[]
  campaigns       Campaign[]
  activityLogs    ActivityLog[]
  reports         Report[]
  fileStorage     FileStorage[]

  @@index([companyId])
  @@index([email])
  @@index([isActive])
  @@index([status])
  @@index([createdAt])
  @@map("users")
}

model Role {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  description String?   @db.Text
  status      String    @default("ACTIVE") @db.VarChar(50)
  isActive    Boolean   @default(true)
  createdBy   String?   @db.VarChar(255)
  updatedBy   String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  users       UserRole[]
  permissions RolePermission[]

  @@index([slug])
  @@index([isActive])
  @@index([status])
  @@index([createdAt])
  @@map("roles")
}

model Permission {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  slug        String    @unique @db.VarChar(100)
  module      String    @db.VarChar(100)
  description String?   @db.Text
  status      String    @default("ACTIVE") @db.VarChar(50)
  createdBy   String?   @db.VarChar(255)
  updatedBy   String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  roles RolePermission[]

  @@index([slug])
  @@index([module])
  @@index([status])
  @@index([createdAt])
  @@map("permissions")
}

model UserRole {
  id        String   @id @default(uuid())
  userId    String
  roleId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId])
  @@index([userId])
  @@index([roleId])
  @@map("user_roles")
}

model RolePermission {
  id           String   @id @default(uuid())
  roleId       String
  permissionId String
  createdAt    DateTime @default(now())

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@index([roleId])
  @@index([permissionId])
  @@map("role_permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique @db.VarChar(500)
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// ============================================
// CAMPAIGN MANAGEMENT
// ============================================

model Campaign {
  id                 String         @id @default(uuid())
  companyId          String
  userId             String
  name               String         @db.VarChar(255)
  description        String?        @db.Text
  objective          String?        @db.Text
  status             CampaignStatus @default(DRAFT)
  scriptId           String?
  promptId           String?
  voiceId            String?
  telephonyProfileId String?        // GSM Gateway + SIM selection
  concurrentCalls    Int            @default(1)
  callDelay          Int            @default(5) // seconds between calls
  maxRetries         Int            @default(3)
  retryDelay         Int            @default(300) // 5 minutes
  startDate          DateTime?
  endDate            DateTime?
  timezone           String?        @db.VarChar(100)
  settings           Json?
  aiConfig           Json?
  createdBy          String?        @db.VarChar(255)
  updatedBy          String?        @db.VarChar(255)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  deletedAt          DateTime?

  company             Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  script              Script?              @relation(fields: [scriptId], references: [id], onDelete: SetNull)
  prompt              Prompt?              @relation(fields: [promptId], references: [id], onDelete: SetNull)
  voice               VoiceProfile?        @relation(fields: [voiceId], references: [id], onDelete: SetNull)
  telephonyProfile    TelephonyProfile?    @relation(fields: [telephonyProfileId], references: [id], onDelete: SetNull)
  calls               Call[]
  contacts            Contact[]            // Keep for backward compatibility
  campaignContacts    CampaignContact[]    // New: uploaded contacts specific to campaign
  campaignUploads     CampaignUpload[]     // Track file uploads
  conversationSessions ConversationSession[] // AI Conversation Engine sessions

  @@index([companyId])
  @@index([userId])
  @@index([status])
  @@index([scriptId])
  @@index([promptId])
  @@index([voiceId])
  @@index([telephonyProfileId])
  @@index([createdAt])
  @@map("campaigns")
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
}

// ============================================
// CONTACT MANAGEMENT
// ============================================

model Contact {
  id            String    @id @default(uuid())
  companyId     String
  campaignId    String?
  firstName     String    @db.VarChar(100)
  lastName      String    @db.VarChar(100)
  fullName      String    @db.VarChar(255)
  phone         String    @db.VarChar(50)
  countryCode   String?   @default("+1") @db.VarChar(10)
  email         String?   @db.VarChar(255)
  language      String    @default("en") @db.VarChar(10)
  city          String?   @db.VarChar(100)
  state         String?   @db.VarChar(100)
  country       String?   @db.VarChar(100)
  postalCode    String?   @db.VarChar(20)
  company       String?   @db.VarChar(255)
  designation   String?   @db.VarChar(100)
  tags          Json?
  notes         String?   @db.Text
  status        String    @default("ACTIVE") @db.VarChar(50)
  isDuplicate   Boolean   @default(false)
  lastCalledAt  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?
  createdBy     String?   @db.VarChar(255)
  updatedBy     String?   @db.VarChar(255)

  companyRef           Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaignRef          Campaign?            @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  calls                Call[]
  conversationSessions ConversationSession[] // AI Conversation Engine sessions

  @@unique([companyId, phone])
  @@unique([companyId, email])
  @@index([companyId])
  @@index([campaignId])
  @@index([phone])
  @@index([email])
  @@index([fullName])
  @@index([status])
  @@index([isDuplicate])
  @@index([language])
  @@index([country])
  @@index([createdAt])
  @@index([lastCalledAt])
  @@map("contacts")
}

// ============================================
// SCRIPT & PROMPT MANAGEMENT
// ============================================

model Script {
  id          String    @id @default(uuid())
  companyId   String
  name        String    @db.VarChar(255)
  language    String    @default("en") @db.VarChar(10)
  description String?   @db.Text
  content     String    @db.LongText
  version     String    @default("1.0.0") @db.VarChar(20)
  status      String    @default("ACTIVE") @db.VarChar(50)
  isActive    Boolean   @default(true)
  createdBy   String?   @db.VarChar(255)
  updatedBy   String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns Campaign[]
  versions  ScriptVersion[]

  @@index([companyId])
  @@index([isActive])
  @@index([status])
  @@index([createdAt])
  @@map("scripts")
}

model Prompt {
  id          String       @id @default(uuid())
  companyId   String
  name        String       @db.VarChar(255)
  category    String?      @db.VarChar(100)
  description String?      @db.Text
  content     String       @db.LongText
  version     String       @default("1.0.0") @db.VarChar(20)
  status      PromptStatus @default(DRAFT)
  temperature Float?       @default(0.7)
  maxTokens   Int?         @default(4000)
  createdBy   String?      @db.VarChar(255)
  updatedBy   String?      @db.VarChar(255)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  deletedAt   DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([companyId])
  @@index([status])
  @@index([category])
  @@index([createdAt])
  @@map("prompts")
}

enum PromptStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

// ============================================
// KNOWLEDGE BASE
// ============================================

model KnowledgeBase {
  id          String            @id @default(uuid())
  companyId   String
  title       String            @db.VarChar(255)
  type        KnowledgeBaseType
  content     String            @db.LongText
  source      String?           @db.VarChar(500)
  category    String?           @db.VarChar(100)
  tags        Json?
  metadata    Json?
  status      String            @default("ACTIVE") @db.VarChar(50)
  isActive    Boolean           @default(true)
  createdBy   String?           @db.VarChar(255)
  updatedBy   String?           @db.VarChar(255)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([type])
  @@index([category])
  @@index([isActive])
  @@index([status])
  @@index([createdAt])
  @@map("knowledge_base")
}

enum KnowledgeBaseType {
  FAQ
  POLICY
  PRICING
  DOCUMENTATION
  WEBSITE
  CUSTOM
}

// ============================================
// VOICE PROFILES (Placeholder for Phase 2)
// ============================================

model VoiceProfile {
  id          String    @id @default(uuid())
  companyId   String
  name        String    @db.VarChar(255)
  description String?   @db.Text
  language    String    @default("en") @db.VarChar(10)
  gender      String?   @db.VarChar(20)
  metadata    Json?
  status      String    @default("ACTIVE") @db.VarChar(50)
  isActive    Boolean   @default(true)
  createdBy   String?   @db.VarChar(255)
  updatedBy   String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  campaigns Campaign[]

  @@index([companyId])
  @@index([isActive])
  @@index([status])
  @@index([createdAt])
  @@map("voice_profiles")
}

// ============================================
// CALL MANAGEMENT (Placeholder for Phase 2)
// ============================================

model Call {
  id          String     @id @default(uuid())
  campaignId  String
  contactId   String
  status      CallStatus @default(PENDING)
  startTime   DateTime?
  endTime     DateTime?
  duration    Int?
  metadata    Json?
  createdBy   String?    @db.VarChar(255)
  updatedBy   String?    @db.VarChar(255)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  campaign    Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact     Contact          @relation(fields: [contactId], references: [id], onDelete: Cascade)
  transcript  CallTranscript?
  recording   CallRecording?

  @@index([campaignId])
  @@index([contactId])
  @@index([status])
  @@index([createdAt])
  @@map("calls")
}

enum CallStatus {
  PENDING
  QUEUED
  CALLING
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

model CallTranscript {
  id        String   @id @default(uuid())
  callId    String   @unique
  content   String   @db.LongText
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_transcripts")
}

model CallRecording {
  id        String   @id @default(uuid())
  callId    String   @unique
  filePath  String   @db.VarChar(500)
  fileSize  Int
  duration  Int
  metadata  Json?
  createdAt DateTime @default(now())

  call Call @relation(fields: [callId], references: [id], onDelete: Cascade)

  @@index([callId])
  @@map("call_recordings")
}

// ============================================
// ANALYTICS & REPORTING
// ============================================

model Analytics {
  id          String   @id @default(uuid())
  companyId   String
  date        DateTime @db.Date
  metric      String   @db.VarChar(100)
  category    String   @db.VarChar(100)
  value       Float
  dimension1  String?  @db.VarChar(255)
  dimension2  String?  @db.VarChar(255)
  dimension3  String?  @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([date])
  @@index([metric])
  @@index([category])
  @@index([createdAt])
  @@map("analytics")
}

model Report {
  id          String     @id @default(uuid())
  companyId   String
  userId      String
  name        String     @db.VarChar(255)
  description String?    @db.Text
  type        ReportType
  parameters  Json?
  schedule    Json?
  format      String     @default("JSON") @db.VarChar(50)
  status      String     @default("ACTIVE") @db.VarChar(50)
  lastRunAt   DateTime?
  nextRunAt   DateTime?
  isActive    Boolean    @default(true)
  createdBy   String?    @db.VarChar(255)
  updatedBy   String?    @db.VarChar(255)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  deletedAt   DateTime?

  company    Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  executions ReportExecution[]

  @@index([companyId])
  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([createdAt])
  @@map("reports")
}

enum ReportType {
  CAMPAIGN_PERFORMANCE
  CONTACT_ANALYSIS
  USER_ACTIVITY
  KNOWLEDGE_BASE_USAGE
  SYSTEM_HEALTH
  CUSTOM
}

model ReportExecution {
  id            String   @id @default(uuid())
  reportId      String
  executedBy    String?
  parameters    Json?
  result        Json?
  status        String   @db.VarChar(50)
  startedAt     DateTime @default(now())
  completedAt   DateTime?
  errorMessage  String?  @db.Text
  filePath      String?  @db.VarChar(500)
  fileSize      Int?
  recordCount   Int?

  report Report @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@index([reportId])
  @@index([status])
  @@index([startedAt])
  @@map("report_executions")
}

// ============================================
// SETTINGS & CONFIGURATION
// ============================================

model Setting {
  id          String   @id @default(uuid())
  companyId   String
  key         String   @db.VarChar(255)
  value       String   @db.Text
  type        String   @db.VarChar(50)
  category    String?  @db.VarChar(100)
  description String?  @db.Text
  isPublic    Boolean  @default(false)
  metadata    Json?
  createdBy   String?  @db.VarChar(255)
  updatedBy   String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, key])
  @@index([companyId])
  @@index([key])
  @@index([category])
  @@index([createdAt])
  @@map("settings")
}

// ============================================
// NOTIFICATIONS & AUDIT
// ============================================

model Notification {
  id          String           @id @default(uuid())
  companyId   String
  userId      String?
  title       String           @db.VarChar(255)
  message     String           @db.Text
  type        NotificationType @default(INFO)
  category    String?          @db.VarChar(100)
  actionUrl   String?          @db.VarChar(500)
  metadata    Json?
  isRead      Boolean          @default(false)
  readAt      DateTime?
  expiresAt   DateTime?
  createdBy   String?          @db.VarChar(255)
  createdAt   DateTime         @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([type])
  @@index([isRead])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("notifications")
}

enum NotificationType {
  SUCCESS
  WARNING
  ERROR
  INFO
  SYSTEM
}

model AuditLog {
  id          String    @id @default(uuid())
  companyId   String
  userId      String?
  entityType  String    @db.VarChar(100)
  entityId    String    @db.VarChar(255)
  action      String    @db.VarChar(100)
  oldValues   Json?
  newValues   Json?
  changes     Json?
  ipAddress   String?   @db.VarChar(45)
  userAgent   String?   @db.Text
  sessionId   String?   @db.VarChar(255)
  metadata    Json?
  createdAt   DateTime  @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([userId])
  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================
// SYSTEM & FILES
// ============================================

model SystemHealth {
  id          String   @id @default(uuid())
  component   String   @db.VarChar(100)
  status      String   @db.VarChar(50)
  version     String?  @db.VarChar(100)
  uptime      Int?
  memory      Json?
  cpu         Json?
  disk        Json?
  network     Json?
  database    Json?
  errors      Json?
  metadata    Json?
  checkedAt   DateTime @default(now())

  @@index([component])
  @@index([status])
  @@index([checkedAt])
  @@map("system_health")
}

model FileStorage {
  id          String    @id @default(uuid())
  companyId   String
  userId      String?
  fileName    String    @db.VarChar(500)
  originalName String   @db.VarChar(500)
  filePath    String    @db.VarChar(1000)
  fileType    String    @db.VarChar(100)
  mimeType    String    @db.VarChar(200)
  fileSize    BigInt
  category    String?   @db.VarChar(100)
  description String?   @db.Text
  metadata    Json?
  isPublic    Boolean   @default(false)
  downloadCount Int     @default(0)
  uploadedBy  String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([fileType])
  @@index([category])
  @@index([createdAt])
  @@map("file_storage")
}

// ============================================
// ACTIVITY LOGS
// ============================================

model ActivityLog {
  id        String   @id @default(uuid())
  companyId String
  userId    String?
  action    String   @db.VarChar(255)
  module    String   @db.VarChar(100)
  entityType String? @db.VarChar(100)
  entityId   String? @db.VarChar(255)
  details   Json?
  ipAddress String?  @db.VarChar(45)
  userAgent String?  @db.Text
  sessionId String?  @db.VarChar(255)
  metadata  Json?
  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([companyId])
  @@index([userId])
  @@index([module])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
  @@map("activity_logs")
}

// ============================================
// AI CORE - Phase 3.1
// ============================================

model AIProvider {
  id          String    @id @default(uuid())
  name        String    @unique @db.VarChar(100)
  type        String    @db.VarChar(50)
  apiEndpoint String?   @db.VarChar(500)
  isActive    Boolean   @default(true)
  metadata    Json?
  createdBy   String?   @db.VarChar(255)
  updatedBy   String?   @db.VarChar(255)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  configs     AIProviderConfig[]
  
  @@index([name])
  @@index([type])
  @@index([isActive])
  @@map("ai_providers")
}

model AIProviderConfig {
  id          String   @id @default(uuid())
  companyId   String
  providerId  String
  apiKey      String   @db.Text
  modelName   String   @db.VarChar(100)
  temperature Float    @default(0.7)
  maxTokens   Int      @default(4000)
  topP        Float?   @default(1.0)
  frequencyPenalty Float? @default(0.0)
  presencePenalty Float? @default(0.0)
  isDefault   Boolean  @default(false)
  isActive    Boolean  @default(true)
  settings    Json?
  createdBy   String?  @db.VarChar(255)
  updatedBy   String?  @db.VarChar(255)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  provider AIProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)

  @@unique([companyId, providerId])
  @@index([companyId])
  @@index([providerId])
