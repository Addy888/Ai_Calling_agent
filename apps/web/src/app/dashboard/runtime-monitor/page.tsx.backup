'use client';

import { useState, useEffect, useRef, useCallback } from 'react';
import { io, Socket } from 'socket.io-client';
import {
  Phone,
  PhoneCall,
  PhoneOff,
  Mic,
  MicOff,
  Bot,
  User,
  Radio,
  Clock,
  Disc,
  TrendingUp,
  Zap,
  Activity,
  CheckCircle,
  XCircle,
  AlertCircle,
  ChevronDown,
  Volume2,
  VolumeX,
  PlayCircle,
  PauseCircle,
  StopCircle,
  Users,
  TrendingDown,
  Loader2,
  Database,
  Brain,
  FileText,
  PhoneIncoming,
  PhoneOutgoing,
  MessageSquare,
  Timer,
  BarChart3,
  Info,
  X,
  ExternalLink,
  Download,
  GitBranch,
  Target,
  Smile,
  Meh,
  Frown,
} from 'lucide-react';
import { Card, CardContent, CardHeader, CardTitle } from '@/components/ui/card';
import { Badge } from '@/components/ui/badge';
import { Progress } from '@/components/ui/progress';
import { Tabs, TabsContent, TabsList, TabsTrigger } from '@/components/ui/tabs';
import { ScrollArea } from '@/components/ui/scroll-area';
import { Button } from '@/components/ui/button';
import {
  Sheet,
  SheetContent,
  SheetDescription,
  SheetHeader,
  SheetTitle,
} from '@/components/ui/sheet';
import { Separator } from '@/components/ui/separator';

// ─────────────────────────────────────────────────────────────────────────────
// Types (mirror the backend interfaces)
// ─────────────────────────────────────────────────────────────────────────────
type CallState =
  | 'IDLE'
  | 'QUEUED'
  | 'INITIALIZING'
  | 'DIALING'
  | 'RINGING'
  | 'CONNECTED'
  | 'GREETING'
  | 'LISTENING'
  | 'PROCESSING'
  | 'GENERATING_RESPONSE'
  | 'PLAYING_RESPONSE'
  | 'WAITING'
  | 'CONTINUING'
  | 'ENDING'
  | 'COMPLETED'
  | 'FAILED'
  | 'RETRY';

type CampaignState = 'IDLE' | 'STARTING' | 'RUNNING' | 'PAUSED' | 'STOPPING' | 'STOPPED' | 'COMPLETED' | 'FAILED';

type CallOutcome = 'completed' | 'busy' | 'no-answer' | 'failed' | 'voicemail' | 'interested' | 'not_interested' | 'callback' | 'wrong_number';
type SentimentType = 'positive' | 'neutral' | 'negative';

interface TranscriptEntry {
  role: 'agent' | 'customer';
  text: string;
  timestamp: Date;
  latencyMs?: number;
  confidence?: number;
}

interface AIProcessingInfo {
  currentIntent?: string;
  currentEmotion?: string;
  promptUsed?: string;
  knowledgeDocsUsed?: string[];
  memoryRetrieved?: any;
  llmResponseTime?: number;
  tokensUsed?: number;
  latency?: number;
  confidenceScore?: number;
}

interface RecordingInfo {
  recordingSid: string;
  url: string;
  durationSeconds: number;
  fileSizeBytes?: number;
  format: string;
  channels: number;
  createdAt: Date;
  status: 'recording' | 'processing' | 'completed';
}

interface CallSummary {
  sessionId: string;
  callSid: string;
  duration: number;
  transcript: TranscriptEntry[];
  outcome: CallOutcome;
  sentiment?: SentimentType;
  keyPoints?: string[];
  nextAction?: string;
  aiSummary?: string;
  customerFeedback?: string;
}

interface CampaignInfo {
  campaignId: string;
  campaignName: string;
  status: CampaignState;
  totalContacts: number;
  queuedCalls: number;
  activeCalls: number;
  completedCalls: number;
  failedCalls: number;
  successRate: number;
  avgCallDuration: number;
}

interface LiveCallData {
  sessionId: string;
  callSid: string;
  state: CallState;
  phoneNumber?: string;
  contactName?: string;
  campaignId?: string;
  campaignName?: string;
  agentId?: string;
  agentName?: string;
  scriptId?: string;
  scriptName?: string;
  knowledgeBaseId?: string;
  knowledgeBaseName?: string;
  memoryContext?: any;
  startTime: Date;
  duration: number;
  transcript: TranscriptEntry[];
  latencyMs?: number;
  recording?: RecordingInfo;
  summary?: CallSummary;
  aiProcessing?: AIProcessingInfo;
  direction: 'inbound' | 'outbound';
  provider: string;
  currentStage?: string;
}

// ─────────────────────────────────────────────────────────────────────────────
// Call state config
// ─────────────────────────────────────────────────────────────────────────────
const STATE_CONFIG: Record<
  CallState,
  { label: string; color: string; bgColor: string; icon: any; pulse: boolean }
> = {
  IDLE: { label: 'Idle', color: 'text-slate-500', bgColor: 'bg-slate-500', icon: Phone, pulse: false },
  QUEUED: { label: 'Queued', color: 'text-gray-500', bgColor: 'bg-gray-500', icon: Clock, pulse: false },
  INITIALIZING: { label: 'Initializing', color: 'text-blue-400', bgColor: 'bg-blue-500', icon: Loader2, pulse: true },
  DIALING: { label: 'Dialing', color: 'text-blue-500', bgColor: 'bg-blue-500', icon: PhoneCall, pulse: true },
  RINGING: { label: 'Ringing', color: 'text-yellow-500', bgColor: 'bg-yellow-500', icon: Phone, pulse: true },
  CONNECTED: { label: 'Connected', color: 'text-green-500', bgColor: 'bg-green-500', icon: PhoneCall, pulse: false },
  GREETING: { label: 'AI Greeting', color: 'text-purple-400', bgColor: 'bg-purple-500', icon: Bot, pulse: true },
  LISTENING: { label: 'Customer Speaking', color: 'text-teal-500', bgColor: 'bg-teal-500', icon: Mic, pulse: true },
  PROCESSING: { label: 'AI Thinking', color: 'text-orange-500', bgColor: 'bg-orange-500', icon: Brain, pulse: true },
  GENERATING_RESPONSE: { label: 'AI Generating', color: 'text-purple-500', bgColor: 'bg-purple-500', icon: Zap, pulse: true },
  PLAYING_RESPONSE: { label: 'AI Speaking', color: 'text-purple-400', bgColor: 'bg-purple-500', icon: Bot, pulse: true },
  WAITING: { label: 'Waiting', color: 'text-amber-500', bgColor: 'bg-amber-500', icon: Clock, pulse: false },
  CONTINUING: { label: 'Conversation Running', color: 'text-cyan-500', bgColor: 'bg-cyan-500', icon: MessageSquare, pulse: true },
  ENDING: { label: 'Call Ending', color: 'text-orange-600', bgColor: 'bg-orange-600', icon: PhoneOff, pulse: false },
  COMPLETED: { label: 'Completed', color: 'text-emerald-500', bgColor: 'bg-emerald-600', icon: CheckCircle, pulse: false },
  FAILED: { label: 'Failed', color: 'text-red-500', bgColor: 'bg-red-500', icon: XCircle, pulse: false },
  RETRY: { label: 'Retrying', color: 'text-yellow-600', bgColor: 'bg-yellow-600', icon: AlertCircle, pulse: true },
};

const CAMPAIGN_STATE_CONFIG: Record<
  CampaignState,
  { label: string; color: string; icon: any }
> = {
  IDLE: { label: 'Idle', color: 'bg-slate-500/10 text-slate-400 border-slate-500/30', icon: PauseCircle },
  STARTING: { label: 'Starting', color: 'bg-blue-500/10 text-blue-400 border-blue-500/30', icon: PlayCircle },
  RUNNING: { label: 'Running', color: 'bg-green-500/10 text-green-400 border-green-500/30', icon: Activity },
  PAUSED: { label: 'Paused', color: 'bg-yellow-500/10 text-yellow-400 border-yellow-500/30', icon: PauseCircle },
  STOPPING: { label: 'Stopping', color: 'bg-orange-500/10 text-orange-400 border-orange-500/30', icon: StopCircle },
  STOPPED: { label: 'Stopped', color: 'bg-red-500/10 text-red-400 border-red-500/30', icon: StopCircle },
  COMPLETED: { label: 'Completed', color: 'bg-emerald-500/10 text-emerald-400 border-emerald-500/30', icon: CheckCircle },
  FAILED: { label: 'Failed', color: 'bg-red-500/10 text-red-400 border-red-500/30', icon: XCircle },
};

const SENTIMENT_CONFIG: Record<SentimentType, { label: string; color: string; icon: any }> = {
  positive: { label: 'Positive', color: 'text-emerald-400', icon: Smile },
  neutral: { label: 'Neutral', color: 'text-slate-400', icon: Meh },
  negative: { label: 'Negative', color: 'text-red-400', icon: Frown },
};

// ─────────────────────────────────────────────────────────────────────────────
// Helper: format seconds as mm:ss
// ─────────────────────────────────────────────────────────────────────────────
function formatDuration(seconds: number): string {
  const m = Math.floor(seconds / 60);
  const s = seconds % 60;
  return `${m}:${s.toString().padStart(2, '0')}`;
}

// ─────────────────────────────────────────────────────────────────────────────
// Waveform animation (purely decorative)
// ─────────────────────────────────────────────────────────────────────────────
function WaveformBars({ active }: { active: boolean }) {
  return (
    <div className="flex items-center gap-0.5 h-8">
      {[3, 6, 4, 8, 5, 7, 3, 6, 9, 4, 7, 5].map((h, i) => (
        <div
          key={i}
          className={`w-1 rounded-full transition-all duration-150 ${
            active ? 'bg-purple-400' : 'bg-slate-600'
          }`}
          style={{
            height: active ? `${h * 3 + Math.random() * 4}px` : '4px',
            animationDelay: `${i * 80}ms`,
          }}
        />
      ))}
    </div>
  );
}

// ─────────────────────────────────────────────────────────────────────────────
// Main Component
// ─────────────────────────────────────────────────────────────────────────────
export default function RuntimeMonitorPage() {
  const [connected, setConnected] = useState(false);
  const [activeCalls, setActiveCalls] = useState<Map<string, LiveCallData>>(new Map());
  const [selectedCallId, setSelectedCallId] = useState<string | null>(null);
  const [drawerOpen, setDrawerOpen] = useState(false);
  const [completedCalls, setCompletedCalls] = useState<CallSummary[]>([]);
  const [campaignInfo, setCampaignInfo] = useState<CampaignInfo | null>(null);
  const socketRef = useRef<Socket | null>(null);
  const timerRef = useRef<NodeJS.Timeout | null>(null);
  const transcriptBottomRef = useRef<HTMLDivElement | null>(null);

  // ─── Duration counter ───────────────────────────────────────────────────
  useEffect(() => {
    timerRef.current = setInterval(() => {
      setActiveCalls(prev => {
        const next = new Map(prev);
        next.forEach((call, id) => {
          if (!['COMPLETED', 'FAILED'].includes(call.state)) {
            next.set(id, {
              ...call,
              duration: Math.floor((Date.now() - new Date(call.startTime).getTime()) / 1000),
            });
          }
        });
        return next;
      });
    }, 1000);
    return () => { if (timerRef.current) clearInterval(timerRef.current); };
  }, []);

  // ─── Auto-scroll transcript ─────────────────────────────────────────────
  useEffect(() => {
    transcriptBottomRef.current?.scrollIntoView({ behavior: 'smooth' });
  }, [activeCalls]);

  // ─── Socket.IO connection ───────────────────────────────────────────────
  useEffect(() => {
    const apiUrl = process.env.NEXT_PUBLIC_API_URL?.replace('/api/v1', '') || 'http://localhost:3001';

    const socket = io(`${apiUrl}/runtime-monitor`, {
      transports: ['websocket', 'polling'],
      reconnectionAttempts: 10,
      reconnectionDelay: 2000,
    });

    socketRef.current = socket;

    socket.on('connect', () => {
      console.log('[RuntimeMonitor] Socket connected:', socket.id);
      setConnected(true);
    });

    socket.on('disconnect', () => {
      console.log('[RuntimeMonitor] Socket disconnected');
      setConnected(false);
    });

    socket.on('monitor:connected', (data: any) => {
      console.log('[RuntimeMonitor] Server greeting:', data);
    });

    // ── Call state changes ────────────────────────────────────────────────
    socket.on('monitor:call_state', (event: {
      sessionId: string;
      callSid: string;
      state: CallState;
      contactName?: string;
      phoneNumber?: string;
      campaignId?: string;
      campaignName?: string;
      agentId?: string;
      agentName?: string;
      scriptId?: string;
      scriptName?: string;
      knowledgeBaseId?: string;
      knowledgeBaseName?: string;
      direction?: 'inbound' | 'outbound';
      provider?: string;
      timestamp: string;
    }) => {
      setActiveCalls(prev => {
        const next = new Map(prev);
        const existing = next.get(event.sessionId);

        if (event.state === 'COMPLETED' || event.state === 'FAILED') {
          // Keep briefly for display, remove after 8s
          if (existing) {
            next.set(event.sessionId, { ...existing, state: event.state });
            setTimeout(() => {
              setActiveCalls(m => {
                const n = new Map(m);
                n.delete(event.sessionId);
                return n;
              });
            }, 8000);
          }
        } else {
          next.set(event.sessionId, {
            sessionId: event.sessionId,
            callSid: event.callSid,
            state: event.state,
            contactName: event.contactName,
            phoneNumber: event.phoneNumber,
            campaignId: event.campaignId,
            campaignName: event.campaignName,
            agentId: event.agentId,
            agentName: event.agentName,
            scriptId: event.scriptId,
            scriptName: event.scriptName,
            knowledgeBaseId: event.knowledgeBaseId,
            knowledgeBaseName: event.knowledgeBaseName,
            direction: event.direction || 'outbound',
            provider: event.provider || 'Twilio',
            currentStage: STATE_CONFIG[event.state]?.label || event.state,
            startTime: existing?.startTime || new Date(),
            duration: existing?.duration || 0,
            transcript: existing?.transcript || [],
            recording: existing?.recording,
            aiProcessing: existing?.aiProcessing,
          });
        }

        return next;
      });

      // Auto-select first call and open drawer
      setSelectedCallId(prev => {
        if (!prev || prev === event.sessionId) {
          setDrawerOpen(true);
          return event.sessionId;
        }
        return prev;
      });
    });

    // ── Transcript entries ────────────────────────────────────────────────
    socket.on('monitor:transcript', (event: {
      sessionId: string;
      callSid: string;
      role: 'agent' | 'customer';
      text: string;
      timestamp: string;
      latencyMs?: number;
      confidence?: number;
    }) => {
      const entry: TranscriptEntry = {
        role: event.role,
        text: event.text,
        timestamp: new Date(event.timestamp),
        latencyMs: event.latencyMs,
        confidence: event.confidence,
      };

      setActiveCalls(prev => {
        const next = new Map(prev);
        const call = next.get(event.sessionId);
        if (call) {
          next.set(event.sessionId, {
            ...call,
            transcript: [...call.transcript, entry],
            latencyMs: event.latencyMs ?? call.latencyMs,
          });
        }
        return next;
      });
    });

    // ── AI Processing Info ────────────────────────────────────────────────
    socket.on('monitor:ai_processing', (event: {
      sessionId: string;
      currentIntent?: string;
      currentEmotion?: string;
      promptUsed?: string;
      knowledgeDocsUsed?: string[];
      memoryRetrieved?: any;
      llmResponseTime?: number;
      tokensUsed?: number;
      latency?: number;
      confidenceScore?: number;
    }) => {
      setActiveCalls(prev => {
        const next = new Map(prev);
        const call = next.get(event.sessionId);
        if (call) {
          next.set(event.sessionId, {
            ...call,
            aiProcessing: {
              currentIntent: event.currentIntent,
              currentEmotion: event.currentEmotion,
              promptUsed: event.promptUsed,
              knowledgeDocsUsed: event.knowledgeDocsUsed,
              memoryRetrieved: event.memoryRetrieved,
              llmResponseTime: event.llmResponseTime,
              tokensUsed: event.tokensUsed,
              latency: event.latency,
              confidenceScore: event.confidenceScore,
            },
          });
        }
        return next;
      });
    });

    // ── Recording ─────────────────────────────────────────────────────────
    socket.on('monitor:recording', (event: {
      sessionId: string;
      callSid: string;
      recording: RecordingInfo;
    }) => {
      setActiveCalls(prev => {
        const next = new Map(prev);
        const call = next.get(event.sessionId);
        if (call) {
          next.set(event.sessionId, { ...call, recording: event.recording });
        }
        return next;
      });
    });

    // ── Summary ──────────────────────────────────────────────────────────
    socket.on('monitor:summary', (event: CallSummary) => {
      setActiveCalls(prev => {
        const next = new Map(prev);
        const call = next.get(event.sessionId);
        if (call) {
          next.set(event.sessionId, { ...call, summary: event });
        }
        return next;
      });
      setCompletedCalls(prev => [event, ...prev].slice(0, 100));
    });

    // ── Campaign Status ──────────────────────────────────────────────────
    socket.on('monitor:campaign_status', (event: {
      campaignId: string;
      campaignName?: string;
      state: CampaignState;
      totalContacts: number;
      processedContacts: number;
      activeCalls: number;
      successfulCalls: number;
      failedCalls: number;
      timestamp: Date;
    }) => {
      const successRate = event.processedContacts > 0 
        ? (event.successfulCalls / event.processedContacts) * 100 
        : 0;
      
      setCampaignInfo({
        campaignId: event.campaignId,
        campaignName: event.campaignName || 'Unknown Campaign',
        status: event.state,
        totalContacts: event.totalContacts,
        queuedCalls: event.totalContacts - event.processedContacts,
        activeCalls: event.activeCalls,
        completedCalls: event.successfulCalls,
        failedCalls: event.failedCalls,
        successRate,
        avgCallDuration: 0, // TODO: Calculate from active calls
      });
    });

    return () => {
      socket.disconnect();
    };
  }, []);

  const selectedCall = selectedCallId ? activeCalls.get(selectedCallId) : null;
  const callsArray = Array.from(activeCalls.values());
  const activeCallsCount = callsArray.filter(c => !['COMPLETED', 'FAILED'].includes(c.state)).length;

  // Calculate avg call duration
  const avgDuration = callsArray.length > 0
    ? Math.floor(callsArray.reduce((sum, call) => sum + call.duration, 0) / callsArray.length)
    : 0;

  // Handle call selection
  const handleCallClick = (sessionId: string) => {
    setSelectedCallId(sessionId);
    setDrawerOpen(true);
  };

  // ─────────────────────────────────────────────────────────────────────────
  return (
    <div className="min-h-screen bg-[#0a0a0f] text-slate-100 p-4 md:p-6 space-y-6">
      {/* ── Header ─────────────────────────────────────────────────────── */}
      <div className="flex items-center justify-between">
        <div>
          <h1 className="text-2xl md:text-3xl font-bold tracking-tight bg-gradient-to-r from-purple-400 via-pink-400 to-teal-400 bg-clip-text text-transparent">
            AI Calling Control Center
          </h1>
          <p className="text-slate-400 text-sm mt-1">
            Real-time campaign monitoring and call analytics
          </p>
        </div>
        <div className="flex items-center gap-2 md:gap-3">
          <div
            className={`flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-medium border ${
              connected
                ? 'bg-emerald-500/10 border-emerald-500/30 text-emerald-400'
                : 'bg-red-500/10 border-red-500/30 text-red-400'
            }`}
          >
            <div className={`w-1.5 h-1.5 rounded-full ${connected ? 'bg-emerald-400 animate-pulse' : 'bg-red-400'}`} />
            {connected ? 'Live' : 'Disconnected'}
          </div>
          <div className="hidden md:flex px-3 py-1.5 rounded-full text-xs font-medium bg-slate-800 border border-slate-700 text-slate-300">
            <Radio className="inline h-3 w-3 mr-1.5 text-purple-400" />
            WebSocket
          </div>
        </div>
      </div>

      {/* ── Campaign Overview ────────────────────────────────────────── */}
      {campaignInfo && (
        <Card className="bg-gradient-to-r from-purple-900/20 via-pink-900/20 to-teal-900/20 border-purple-500/20">
          <CardContent className="p-4 md:p-6">
            <div className="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
              <div className="flex-1">
                <div className="flex items-center gap-3 mb-2">
                  <Activity className="h-5 w-5 text-purple-400" />
                  <h2 className="text-xl font-semibold text-white">{campaignInfo.campaignName}</h2>
                </div>
                <div className="flex items-center gap-2">
                  {(() => {
                    const config = CAMPAIGN_STATE_CONFIG[campaignInfo.status];
                    const Icon = config.icon;
                    return (
                      <Badge className={`${config.color} border`}>
                        <Icon className="h-3 w-3 mr-1" />
                        {config.label}
                      </Badge>
                    );
                  })()}
                  <span className="text-sm text-slate-400">
                    {campaignInfo.successRate.toFixed(1)}% Success Rate
                  </span>
                </div>
              </div>
              
              <div className="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
                <div className="text-center">
                  <p className="text-xs text-slate-400 mb-1">Total Contacts</p>
                  <p className="text-2xl font-bold text-white">{campaignInfo.totalContacts}</p>
                </div>
                <div className="text-center">
                  <p className="text-xs text-slate-400 mb-1">Queued</p>
                  <p className="text-2xl font-bold text-yellow-400">{campaignInfo.queuedCalls}</p>
                </div>
                <div className="text-center">
                  <p className="text-xs text-slate-400 mb-1">Active</p>
                  <p className="text-2xl font-bold text-green-400">{campaignInfo.activeCalls}</p>
                </div>
                <div className="text-center">
                  <p className="text-xs text-slate-400 mb-1">Completed</p>
                  <p className="text-2xl font-bold text-emerald-400">{campaignInfo.completedCalls}</p>
                </div>
              </div>
            </div>
            
            <div className="mt-4">
              <div className="flex items-center justify-between text-xs text-slate-400 mb-1">
                <span>Campaign Progress</span>
                <span>{((campaignInfo.completedCalls + campaignInfo.failedCalls) / campaignInfo.totalContacts * 100).toFixed(1)}%</span>
              </div>
              <Progress 
                value={(campaignInfo.completedCalls + campaignInfo.failedCalls) / campaignInfo.totalContacts * 100} 
                className="h-2"
              />
            </div>
          </CardContent>
        </Card>
      )}

      {/* ── Stats Row ──────────────────────────────────────────────────── */}
      <div className="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-4">
        {[
          {
            label: 'Active Calls',
            value: activeCallsCount,
            icon: PhoneCall,
            color: 'text-purple-400',
            bg: 'bg-purple-500/10',
            border: 'border-purple-500/20',
          },
          {
            label: 'Completed',
            value: completedCalls.filter(c => c.outcome === 'completed').length,
            icon: CheckCircle,
            color: 'text-emerald-400',
            bg: 'bg-emerald-500/10',
            border: 'border-emerald-500/20',
          },
          {
            label: 'Failed',
            value: completedCalls.filter(c => c.outcome === 'failed').length,
            icon: XCircle,
            color: 'text-red-400',
            bg: 'bg-red-500/10',
            border: 'border-red-500/20',
          },
          {
            label: 'Avg Duration',
            value: formatDuration(avgDuration),
            icon: Timer,
            color: 'text-cyan-400',
            bg: 'bg-cyan-500/10',
            border: 'border-cyan-500/20',
          },
        ].map(stat => (
          <Card key={stat.label} className={`bg-slate-900/60 border ${stat.border}`}>
            <CardContent className="p-3 md:p-4">
              <div className="flex items-center justify-between">
                <div className="flex-1">
                  <p className="text-xs text-slate-400 mb-1">{stat.label}</p>
                  <p className={`text-xl md:text-2xl font-bold ${stat.color}`}>{stat.value}</p>
                </div>
                <div className={`p-2 rounded-lg ${stat.bg}`}>
                  <stat.icon className={`h-4 w-4 md:h-5 md:w-5 ${stat.color}`} />
                </div>
              </div>
            </CardContent>
          </Card>
        ))}
      </div>

      {/* ── Main Content: Live Calls Table ───────────────────────────────── */}
      <Card className="bg-slate-900/60 border-slate-800">
        <CardHeader>
          <div className="flex items-center justify-between">
            <CardTitle className="text-lg font-semibold text-slate-100 flex items-center gap-2">
              <Activity className="h-5 w-5 text-purple-400" />
              Live Calls
            </CardTitle>
            <Badge variant="outline" className="border-slate-700 text-slate-400 text-xs">
              {callsArray.length} call{callsArray.length !== 1 ? 's' : ''}
            </Badge>
          </div>
        </CardHeader>
        <CardContent>
          {callsArray.length === 0 ? (
            <div className="text-center py-12">
              <Phone className="h-16 w-16 text-slate-700 mx-auto mb-4" />
              <p className="text-slate-400 text-lg font-medium mb-2">No Active Calls</p>
              <p className="text-slate-600 text-sm">
                Calls will appear here when campaigns are running
              </p>
            </div>
          ) : (
            <div className="overflow-x-auto">
              <table className="w-full">
                <thead>
                  <tr className="border-b border-slate-800">
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider">
                      Status
                    </th>
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider">
                      Contact
                    </th>
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider">
                      Phone
                    </th>
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider hidden md:table-cell">
                      Campaign
                    </th>
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider hidden lg:table-cell">
                      AI Agent
                    </th>
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider hidden xl:table-cell">
                      Script
                    </th>
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider">
                      Duration
                    </th>
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider">
                      Stage
                    </th>
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider hidden lg:table-cell">
                      Direction
                    </th>
                    <th className="text-left py-3 px-3 text-xs font-medium text-slate-400 uppercase tracking-wider hidden xl:table-cell">
                      Provider
                    </th>
                  </tr>
                </thead>
                <tbody className="divide-y divide-slate-800">
                  {callsArray.map(call => {
                    const cfg = STATE_CONFIG[call.state] || STATE_CONFIG.IDLE;
                    const Icon = cfg.icon;
                    const isSelected = selectedCallId === call.sessionId;

                    return (
                      <tr
                        key={call.sessionId}
                        onClick={() => handleCallClick(call.sessionId)}
                        className={`cursor-pointer transition-colors ${
                          isSelected
                            ? 'bg-purple-500/10 hover:bg-purple-500/20'
                            : 'hover:bg-slate-800/50'
                        }`}
                      >
                        <td className="py-3 px-3">
                          <div className="flex items-center gap-2">
                            <div className={`relative p-1.5 rounded-lg ${cfg.bgColor} bg-opacity-20`}>
                              <Icon className={`h-3.5 w-3.5 ${cfg.color} ${cfg.pulse ? 'animate-pulse' : ''}`} />
                            </div>
                          </div>
                        </td>
                        <td className="py-3 px-3">
                          <p className="text-sm font-medium text-slate-200 truncate max-w-[150px]">
                            {call.contactName || 'Unknown'}
                          </p>
                        </td>
                        <td className="py-3 px-3">
                          <p className="text-sm text-slate-400 font-mono">
                            {call.phoneNumber || '—'}
                          </p>
                        </td>
                        <td className="py-3 px-3 hidden md:table-cell">
                          <p className="text-sm text-slate-300 truncate max-w-[120px]">
                            {call.campaignName || 'Unknown Campaign'}
                          </p>
                        </td>
                        <td className="py-3 px-3 hidden lg:table-cell">
                          <p className="text-sm text-slate-300 truncate max-w-[100px]">
                            {call.agentName || '—'}
                          </p>
                        </td>
                        <td className="py-3 px-3 hidden xl:table-cell">
                          <p className="text-sm text-slate-400 truncate max-w-[100px]">
                            {call.scriptName || '—'}
                          </p>
                        </td>
                        <td className="py-3 px-3">
                          <p className="text-sm text-slate-300 font-mono">
                            {formatDuration(call.duration)}
                          </p>
                        </td>
                        <td className="py-3 px-3">
                          <Badge className={`text-xs ${cfg.color} bg-opacity-10`}>
                            {cfg.label}
                          </Badge>
                        </td>
                        <td className="py-3 px-3 hidden lg:table-cell">
                          <div className="flex items-center gap-1">
                            {call.direction === 'outbound' ? (
                              <>
                                <PhoneOutgoing className="h-3.5 w-3.5 text-blue-400" />
                                <span className="text-xs text-slate-400">Out</span>
                              </>
                            ) : (
                              <>
                                <PhoneIncoming className="h-3.5 w-3.5 text-green-400" />
                                <span className="text-xs text-slate-400">In</span>
                              </>
                            )}
                          </div>
                        </td>
                        <td className="py-3 px-3 hidden xl:table-cell">
                          <p className="text-xs text-slate-500">{call.provider}</p>
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>
            </div>
          )}
        </CardContent>
      </Card>
            <div className="space-y-4">
              {/* Call Header */}
              <Card className="bg-slate-900/60 border-slate-800">
                <CardContent className="p-4">
                  <div className="flex items-center justify-between flex-wrap gap-3">
                    <div className="flex items-center gap-3">
                      {(() => {
                        const cfg = STATE_CONFIG[selectedCall.state] || STATE_CONFIG.IDLE;
                        const Icon = cfg.icon;
                        return (
                          <>
                            <div className={`p-2.5 rounded-xl ${cfg.color}`}>
                              <Icon className="h-5 w-5 text-white" />
                            </div>
                            <div>
                              <p className="font-semibold text-slate-100">
                                {selectedCall.contactName || selectedCall.phoneNumber || 'Unknown Contact'}
                              </p>
                              <p className="text-xs text-slate-500 font-mono">{selectedCall.callSid}</p>
                            </div>
                          </>
                        );
                      })()}
                    </div>
                    <div className="flex items-center gap-4">
                      {/* Duration */}
                      <div className="flex items-center gap-1.5 text-slate-300">
                        <Clock className="h-3.5 w-3.5 text-slate-500" />
                        <span className="font-mono text-sm">{formatDuration(selectedCall.duration)}</span>
                      </div>
                      {/* Latency */}
                      {selectedCall.latencyMs && (
                        <div className="flex items-center gap-1.5">
                          <Zap className="h-3.5 w-3.5 text-yellow-400" />
                          <span className="text-sm text-yellow-400 font-mono">{selectedCall.latencyMs}ms</span>
                        </div>
                      )}
                      {/* Recording indicator */}
                      {selectedCall.recording && (
                        <div className="flex items-center gap-1.5 text-red-400">
                          <Disc className="h-3.5 w-3.5 animate-pulse" />
                          <span className="text-xs">REC</span>
                        </div>
                      )}
                      {/* State badge */}
                      {(() => {
                        const cfg = STATE_CONFIG[selectedCall.state] || STATE_CONFIG.IDLE;
                        return (
                          <span className={`text-xs px-2.5 py-1 rounded-full font-medium ${cfg.color} text-white`}>
                            {cfg.label}
                          </span>
                        );
                      })()}
                    </div>
                  </div>

                  {/* Waveform */}
                  <div className="mt-3 flex items-center gap-3">
                    <Bot className="h-4 w-4 text-purple-400 flex-shrink-0" />
                    <WaveformBars active={selectedCall.state === 'AI_SPEAKING'} />
                    <div className="flex-1 h-px bg-slate-700" />
                    <WaveformBars active={selectedCall.state === 'CUSTOMER_SPEAKING'} />
                    <User className="h-4 w-4 text-teal-400 flex-shrink-0" />
                  </div>
                </CardContent>
              </Card>

              <Tabs defaultValue="transcript">
                <TabsList className="bg-slate-900 border border-slate-800">
                  <TabsTrigger value="transcript" className="data-[state=active]:bg-slate-700 data-[state=active]:text-slate-100">
                    Transcript ({selectedCall.transcript.length})
                  </TabsTrigger>
                  <TabsTrigger value="summary" className="data-[state=active]:bg-slate-700 data-[state=active]:text-slate-100">
                    Summary
                  </TabsTrigger>
                  <TabsTrigger value="recording" className="data-[state=active]:bg-slate-700 data-[state=active]:text-slate-100">
                    Recording
                  </TabsTrigger>
                </TabsList>

                {/* ── Transcript Tab ─────────────────────────────────── */}
                <TabsContent value="transcript">
                  <Card className="bg-slate-900/60 border-slate-800">
                    <CardContent className="p-0">
                      <ScrollArea className="h-[400px] p-4">
                        {selectedCall.transcript.length === 0 ? (
                          <div className="flex items-center justify-center h-full text-slate-500 text-sm">
                            <Mic className="h-4 w-4 mr-2" />
                            Waiting for conversation to begin...
                          </div>
                        ) : (
                          <div className="space-y-3">
                            {selectedCall.transcript.map((entry, i) => (
                              <div
                                key={i}
                                className={`flex gap-3 ${
                                  entry.role === 'agent' ? 'flex-row' : 'flex-row-reverse'
                                }`}
                              >
                                <div className={`flex-shrink-0 w-7 h-7 rounded-full flex items-center justify-center ${
                                  entry.role === 'agent'
                                    ? 'bg-purple-500/20 border border-purple-500/30'
                                    : 'bg-teal-500/20 border border-teal-500/30'
                                }`}>
                                  {entry.role === 'agent'
                                    ? <Bot className="h-3.5 w-3.5 text-purple-400" />
                                    : <User className="h-3.5 w-3.5 text-teal-400" />
                                  }
                                </div>
                                <div className={`flex-1 max-w-[80%] ${entry.role === 'agent' ? '' : 'items-end flex flex-col'}`}>
                                  <div className={`rounded-2xl px-4 py-2.5 text-sm ${
                                    entry.role === 'agent'
                                      ? 'bg-purple-500/10 border border-purple-500/20 text-slate-200 rounded-tl-sm'
                                      : 'bg-teal-500/10 border border-teal-500/20 text-slate-200 rounded-tr-sm'
                                  }`}>
                                    {entry.text}
                                  </div>
                                  <div className={`flex items-center gap-2 mt-1 ${entry.role === 'agent' ? '' : 'justify-end'}`}>
                                    <span className="text-xs text-slate-600">
                                      {new Date(entry.timestamp).toLocaleTimeString()}
                                    </span>
                                    {entry.latencyMs && (
                                      <span className="text-xs text-yellow-600 font-mono">
                                        {entry.latencyMs}ms
                                      </span>
                                    )}
                                  </div>
                                </div>
                              </div>
                            ))}
                            <div ref={transcriptBottomRef} />
                          </div>
                        )}
                      </ScrollArea>
                    </CardContent>
                  </Card>
                </TabsContent>

                {/* ── Summary Tab ────────────────────────────────────── */}
                <TabsContent value="summary">
                  <Card className="bg-slate-900/60 border-slate-800">
                    <CardContent className="p-5 space-y-4">
                      {!selectedCall.summary ? (
                        <div className="text-center py-8 text-slate-500 text-sm">
                          <Clock className="h-6 w-6 mx-auto mb-2 text-slate-600" />
                          Summary will appear when the call ends
                        </div>
                      ) : (
                        <>
                          {/* Outcome */}
                          <div className="flex items-center gap-3">
                            <span className="text-slate-400 text-sm">Outcome:</span>
                            <Badge className={
                              selectedCall.summary.outcome === 'completed'
                                ? 'bg-emerald-500/20 text-emerald-400 border-emerald-500/30'
                                : 'bg-red-500/20 text-red-400 border-red-500/30'
                            }>
                              {selectedCall.summary.outcome.toUpperCase()}
                            </Badge>
                          </div>

                          {/* Duration */}
                          <div className="flex items-center gap-3">
                            <span className="text-slate-400 text-sm">Duration:</span>
                            <span className="font-mono text-slate-200">
                              {formatDuration(selectedCall.summary.duration)}
                            </span>
                          </div>

                          {/* Sentiment */}
                          {selectedCall.summary.sentiment && (() => {
                            const s = SENTIMENT_CONFIG[selectedCall.summary!.sentiment!];
                            return (
                              <div className="flex items-center gap-3">
                                <span className="text-slate-400 text-sm">Sentiment:</span>
                                <span className={`flex items-center gap-1 text-sm font-medium ${s.color}`}>
                                  <s.icon className="h-3.5 w-3.5" />
                                  {s.label}
                                </span>
                              </div>
                            );
                          })()}

                          {/* Key Points */}
                          {selectedCall.summary.keyPoints && selectedCall.summary.keyPoints.length > 0 && (
                            <div>
                              <p className="text-slate-400 text-sm mb-2">Key Points:</p>
                              <ul className="space-y-1.5">
                                {selectedCall.summary.keyPoints.map((point, i) => (
                                  <li key={i} className="flex items-start gap-2 text-sm text-slate-300">
                                    <CheckCircle className="h-3.5 w-3.5 text-emerald-400 mt-0.5 flex-shrink-0" />
                                    {point}
                                  </li>
                                ))}
                              </ul>
                            </div>
                          )}

                          {/* Next Action */}
                          {selectedCall.summary.nextAction && (
                            <div className="bg-blue-500/10 border border-blue-500/20 rounded-lg p-3">
                              <p className="text-xs text-blue-400 font-medium mb-1">Recommended Next Action</p>
                              <p className="text-sm text-slate-200">{selectedCall.summary.nextAction}</p>
                            </div>
                          )}
                        </>
                      )}
                    </CardContent>
                  </Card>
                </TabsContent>

                {/* ── Recording Tab ──────────────────────────────────── */}
                <TabsContent value="recording">
                  <Card className="bg-slate-900/60 border-slate-800">
                    <CardContent className="p-5">
                      {!selectedCall.recording ? (
                        <div className="text-center py-8 text-slate-500 text-sm">
                          <Disc className="h-6 w-6 mx-auto mb-2 text-slate-600" />
                          Recording will appear when the call ends
                        </div>
                      ) : (
                        <div className="space-y-3">
                          <div className="flex items-center gap-3 p-3 bg-slate-800 rounded-lg border border-slate-700">
                            <Disc className="h-8 w-8 text-red-400" />
                            <div className="flex-1 min-w-0">
                              <p className="text-sm font-medium text-slate-200 truncate">
                                {selectedCall.recording.recordingSid}
                              </p>
                              <p className="text-xs text-slate-500 mt-0.5">
                                {formatDuration(selectedCall.recording.durationSeconds)} · {selectedCall.recording.format.toUpperCase()} · {selectedCall.recording.channels}ch
                              </p>
                            </div>
                            <Badge className="bg-red-500/20 text-red-400 border-red-500/30 text-xs">
                              REC
                            </Badge>
                          </div>

                          {selectedCall.recording.fileSizeBytes && (
                            <p className="text-xs text-slate-500">
                              File size: {(selectedCall.recording.fileSizeBytes / 1024).toFixed(1)} KB
                            </p>
                          )}

                          <div className="font-mono text-xs text-slate-500 bg-slate-800/50 p-2 rounded truncate">
                            {selectedCall.recording.url}
                          </div>
                        </div>
                      )}
                    </CardContent>
                  </Card>
                </TabsContent>
              </Tabs>
            </div>
          )}
        </div>
      </div>

      {/* ── Completed Calls History ─────────────────────────────────────── */}
      {completedCalls.length > 0 && (
        <div>
          <h2 className="text-sm font-semibold text-slate-400 uppercase tracking-wider mb-3">
            Recent Completed Calls
          </h2>
          <div className="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">
            {completedCalls.slice(0, 6).map((summary, i) => {
              const sentiment = summary.sentiment ? SENTIMENT_CONFIG[summary.sentiment] : null;
              return (
                <Card key={i} className="bg-slate-900/60 border-slate-800">
                  <CardContent className="p-4 space-y-2">
                    <div className="flex items-center justify-between">
                      <Badge className={
                        summary.outcome === 'completed'
                          ? 'bg-emerald-500/15 text-emerald-400 border-emerald-500/25 text-xs'
                          : 'bg-red-500/15 text-red-400 border-red-500/25 text-xs'
                      }>
                        {summary.outcome.toUpperCase()}
                      </Badge>
                      <span className="font-mono text-xs text-slate-400">{formatDuration(summary.duration)}</span>
                    </div>
                    <p className="text-xs font-mono text-slate-600 truncate">{summary.callSid}</p>
                    {sentiment && (
                      <div className={`flex items-center gap-1 text-xs ${sentiment.color}`}>
                        <sentiment.icon className="h-3 w-3" />
                        {sentiment.label}
                      </div>
                    )}
                    {summary.keyPoints && summary.keyPoints.length > 0 && (
                      <p className="text-xs text-slate-400 truncate">{summary.keyPoints[0]}</p>
                    )}
                  </CardContent>
                </Card>
              );
            })}
          </div>
        </div>
      )}
    </div>
  );
}
