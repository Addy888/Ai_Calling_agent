# Service Configuration
SERVICE_NAME=training-engine
SERVICE_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=0.0.0.0
PORT=8001
WORKERS=1

# API Configuration
API_PREFIX=/api/v1
API_TITLE="AI Training Engine"
API_DESCRIPTION="Enterprise AI Training Infrastructure"

# Security
JWT_SECRET_KEY=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
INTERNAL_API_KEY=your-internal-api-key-change-in-production

# NestJS Backend Integration
NESTJS_API_URL=http://localhost:3000
NESTJS_API_KEY=your-nestjs-api-key

# Training Configuration
MAX_CONCURRENT_JOBS=2
DEFAULT_BATCH_SIZE=8
DEFAULT_EPOCHS=3
MAX_TRAINING_DURATION=86400
CHECKPOINT_INTERVAL=100

# Storage
TRAINING_DATA_DIR=./data/training
MODEL_OUTPUT_DIR=./data/models
CHECKPOINT_DIR=./data/checkpoints
LOG_DIR=./logs

# Resource Limits
MAX_CPU_PERCENT=80
MAX_MEMORY_PERCENT=85
MIN_DISK_SPACE_GB=10

# GPU Configuration (Future)
ENABLE_GPU=false
GPU_DEVICES=0
MIXED_PRECISION=false

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# Monitoring (Future)
ENABLE_TENSORBOARD=false
ENABLE_WANDB=false
WANDB_PROJECT=ai-calling-agent
WANDB_ENTITY=

# Queue Configuration
QUEUE_TYPE=memory
REDIS_URL=redis://localhost:6379/0

# Health Check
HEALTH_CHECK_INTERVAL=30
